//підлключення бібліотек вектора-з масивами стрінга-бібліотека для роботи з символами і айосстрім-для введення і виведення

#include <iostream>
#include <string>
#include <vector>

//виключення вічного введення СТД

using namespace std; 

//Запуск основної програми

int main() {
    
//****************************************************************************************
    
//зберігання речення і слів для подальшого використання
    
    string sentence, word;
    
//вектор стрінг вордс створює масив в якому зберігаються самі слова з речення 

    vector<string> words;
    
//****************************************************************************************

//через getline(cin, sentence); отримує доступ до речення з пробілами

    cout << "Введіть речення: ";
    getline(cin, sentence);
    
//обирається шукане слово

    cout << "Введіть слово для пошуку: ";
    cin >> word;
    
//задання тимчасової змінної    

    string temp = "";
    
//фор запускає цикл в якому задано змінну і яка повинна бути менше або дорівнювати кількості символів
//ще змінна і збільшується ні 1 після кожного циклу

    for (int i = 0; i <= sentence.length(); i++) {
        
//тут перевіряється слово, якщо при зчитуванні програма наткнеться на пробіл або на кінець речення то
//слово додається до масиву *вектору* 

        if (sentence[i] == ' ' || i == sentence.length()) {

//перевіряється чи тимчасова змінна не порожня            
            if (temp != "") {
                
//сформоване слово додається до вектора  

                words.push_back(temp);
                
//після того як слово визначили змінна онуляється і стає порожньою, після чого цикл повторюється

                temp = "";
            }
        }
        
//якщо змінна не є пробілом вона додасться до змінної темп        
        else {
            
//до змінної темп додається сентанс (і) після чого отриманий результат замінює змінну з тимчасової           
            temp += sentence[i];
        }
    }

//створення нової змінної для пошуку номера слова в реченні

    int banana = 0;

    cout << "Слово знайдено на позиціях: ";

//перебирає всі слова з вектора поки не натикається на шукане 

    for (int i = 0; i < words.size(); i++) {
        
// перевірка чи збігається шукане слово зі збереженим словом

        if (words[i] == word) {
            
//якщо збігаються то виводиться позиція слова

            cout << i + 1 << " ";
            
//кількість уже знайдених слів збільшується на 1             
            banana++;
        }
    }

//якщо так і не знайшлося виведеться текст а якщо знайшлося то напише в яких позиціях і скільки

    if (banana == 0) {
        cout << "Слово не знайдено";
    }
    else {
        cout << "\nКількість входжень: " << banana;
    }

    return 0;
}
